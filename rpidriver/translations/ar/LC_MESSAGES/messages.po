# Config schema — help texts
msgid "Hardware drivers to load at startup.  Changes require restart."
msgstr "مشغّلات الأجهزة للتحميل عند بدء التشغيل. التغييرات تتطلب إعادة التشغيل."

msgid "IP to bind to.  Use 0.0.0.0 for all interfaces."
msgstr "عنوان IP للربط. استخدم 0.0.0.0 لجميع الواجهات."

msgid "TCP port for the RPiDriver server."
msgstr "منفذ TCP لخادم RPiDriver."

msgid "Enable Flask debug mode.  Never use in production."
msgstr "تفعيل وضع تشخيص Flask. لا تستخدمه في الإنتاج أبداً."

msgid "Dashboard Password"
msgstr "كلمة مرور لوحة التحكم"

msgid "Password to access the web dashboard.  Leave empty to disable authentication (LAN-only setups)."
msgstr "كلمة المرور للوصول إلى لوحة التحكم. اتركها فارغة لتعطيل المصادقة (شبكات LAN المغلقة)."

msgid "CORS Allowed Origins"
msgstr "الأصول المسموح بها (CORS)"

msgid "Origins allowed to call /hw_proxy/* endpoints.  Use * to allow any Odoo instance."
msgstr "الأصول المسموح لها باستدعاء /hw_proxy/*. استخدم * للسماح لأي نسخة Odoo."

msgid "IP address of the NeoLeap terminal on the local network."
msgstr "عنوان IP لطرفية NeoLeap على الشبكة المحلية."

msgid "Terminal ID: either the 8-digit bank TID (Al Rajhi, SNB …) or the 16-digit device TID shown on the terminal screen."
msgstr "رقم الطرفية: إما 8 أرقام من البنك (الراجحي، SNB ...) أو 16 رقماً من شاشة إعدادات الجهاز."

msgid "NeoLeap WebSocket port.  N950 uses 9998.  Do not change unless instructed by NeoLeap."
msgstr "منفذ WebSocket لـ NeoLeap. N950 يستخدم 9998. لا تغيّر إلا بتعليمات NeoLeap."

msgid "Seconds to wait for the customer to complete a payment."
msgstr "ثوانٍ الانتظار لإتمام العميل عملية الدفع."

msgid "Seconds before a completed transaction auto-resets to idle."
msgstr "ثوانٍ قبل إعادة ضبط المعاملة المكتملة تلقائياً."

msgid "Paper width in dots.  80 mm printers use 576; 58 mm use 384."
msgstr "عرض الورق بالنقاط. طابعات 80 مم تستخدم 576؛ 58 مم تستخدم 384."

msgid "Text printed at the bottom of every receipt."
msgstr "النص المطبوع في أسفل كل إيصال."

msgid "Full path to a TrueType Arabic font.  Leave empty to use the bundled font."
msgstr "المسار الكامل لخط TrueType عربي. اتركه فارغاً لاستخدام الخط المرفق."

msgid "Serial device path for the scale."
msgstr "مسار جهاز المسلسل للميزان."

msgid "Serial protocol used by the scale model."
msgstr "بروتوكول المسلسل المستخدم في الميزان."

msgid "Unit displayed in Odoo POS."
msgstr "الوحدة المعروضة في Odoo POS."

msgid "Serial read timeout per polling cycle."
msgstr "مهلة قراءة المسلسل لكل دورة استطلاع."

msgid "Serial device path for the customer display (USB-CDC)."
msgstr "مسار جهاز المسلسل لشاشة العميل (USB-CDC)."

msgid "Serial baud rate.  Most 2×20 displays use 9600."
msgstr "معدل نقل المسلسل. معظم الشاشات 2×20 تستخدم 9600."

msgid "Hostname or IP of the CUPS server."
msgstr "اسم المضيف أو عنوان IP لخادم CUPS."

msgid "CUPS server port (default: 631)."
msgstr "منفذ خادم CUPS (الافتراضي: 631)."

msgid "Name of the printer queue in CUPS."
msgstr "اسم طابور الطابعة في CUPS."

msgid "Printing backend.  Auto selects pycups when available."
msgstr "خلفية الطباعة. تلقائي يختار pycups عند توفره."

